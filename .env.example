# ---------------------------------------------------------------------------
# Revision por IA (opcional). Sin esto el sistema funciona solo con reglas.
# Copia este archivo como ".env" y pega tu clave real.
# ---------------------------------------------------------------------------

# Proveedor: "openai" | "gemini"
AI_PROVIDER=openai
AI_ENABLED=false

# Clave. Si usas Gemini tambien se acepta GEMINI_API_KEY (alias).
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# URL personalizada (opcional). Gemini usa por defecto su endpoint oficial.
AI_BASE_URL=

# Alias para Gemini (permite reutilizar un .env de otro proyecto).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Limites de subida
MAX_UPLOAD_MB=25